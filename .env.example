# Prefer: python3.12 scripts/local_runtime.py init
# It creates an owner-only .local/dev-runtime/.env with random local passwords.
COMPOSE_PROJECT_NAME=closegraph-local
CLOSEGRAPH_POSTGRES_IMAGE=postgres:16-alpine
CLOSEGRAPH_POSTGRES_PORT=55432
POSTGRES_DB=closegraph
POSTGRES_USER=closegraph
POSTGRES_PASSWORD=replace-with-a-generated-local-password
CLOSEGRAPH_DATABASE_URL=postgresql+psycopg://closegraph:replace-with-a-generated-local-password@127.0.0.1:55432/closegraph
CLOSEGRAPH_PREPARER_PASSWORD=replace-with-a-generated-local-password
CLOSEGRAPH_REVIEWER_PASSWORD=replace-with-a-different-generated-local-password
CLOSEGRAPH_DATA_DIR=.local/dev-runtime/data

# Optional synthetic captured evidence, explicitly replayed (no provider key).
CLOSEGRAPH_PDF_MODE=DISABLED
# CLOSEGRAPH_PDF_CAPTURE_DIR=/absolute/path/to/artifacts/live-reducto
