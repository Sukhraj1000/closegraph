{
  "name": "closegraph",
  "version": "0.0.0",
  "private": true,
  "description": "Source-backed reporting-pack correction, deterministic verification and independent exact-version release.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "spec:validate": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "spec:status": "OPENSPEC_TELEMETRY=0 openspec list",
    "spec:list": "OPENSPEC_TELEMETRY=0 openspec list",
    "spec:check": "npm run spec:validate && npm run spec:status",
    "loop:test": "python3.12 -m unittest discover -s automation/tests -v",
    "loop:status": "python3.12 -m automation.cron_tools status",
    "demo": "node scripts/demo.mjs",
    "demo:accounts": "node scripts/demo.mjs --accounts"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.10.0"
  }
}
